pipeline {
    agent any

    environment {
        SONAR_HOST_URL = "http://192.168.50.4:9000"
    }

    stages {
        // Stage 1: Checkout source code
        stage('Checkout Source Code') {
            steps {
                script {
                    echo "🔄 Checking out source code from GitHub..."
                    git branch: 'main', url: 'https://github.com/Aya-Bs/Lavoro.git'
                    echo "✅ Source code checkout completed"
                }
            }
        }

        // Stage 2: Verify workspace and files
        stage('Verify Project Structure') {
            steps {
                script {
                    echo "📁 Current workspace contents:"
                    sh 'ls -la'
                    
                    echo "🔍 Checking for required files..."
                    
                    if (fileExists('sonar-project.properties')) {
                        echo "✅ sonar-project.properties found"
                        echo "📄 sonar-project.properties content:"
                        sh 'head -10 sonar-project.properties'
                    } else {
                        error("❌ sonar-project.properties file is required for SonarQube analysis")
                    }
                }
            }
        }

        // Stage 3: SonarQube Analysis
        stage('SonarQube Analysis') {
            steps {
                script {
                    echo "🔍 Starting SonarQube analysis..."
                    
                    // Check Java version compatibility
                    def javaVersion = sh(script: 'java -version 2>&1 | head -1', returnStdout: true).trim()
                    echo "☕ Current Java version: ${javaVersion}"
                    
                    try {
                        // First, try to use a compatible local scanner (older version)
                        echo "📦 Trying local sonar-scanner installations..."
                        def scanner470Path = "./sonar-scanner-4.7.0.2747"
                        def scanner480Path = "./sonar-scanner-4.8.0.2856"
                        
                        if (fileExists("${scanner470Path}/bin/sonar-scanner")) {
                            echo "✅ Using SonarQube Scanner 4.7.0 (Java 11 compatible)"
                            // Replace 'YOUR_ACTUAL_TOKEN_HERE' with the token you generated from SonarQube
                            sh "${scanner470Path}/bin/sonar-scanner -Dsonar.token=YOUR_ACTUAL_TOKEN_HERE -Dsonar.verbose=true"
                        } else if (fileExists("${scanner480Path}/bin/sonar-scanner")) {
                            echo "✅ Using SonarQube Scanner 4.8.0"
                            // Replace 'YOUR_ACTUAL_TOKEN_HERE' with the token you generated from SonarQube
                            sh "${scanner480Path}/bin/sonar-scanner -Dsonar.token=YOUR_ACTUAL_TOKEN_HERE -Dsonar.verbose=true"
                        } else {
                            // Fallback to system scanner with Java version check
                            echo "🔧 Using system sonar-scanner with compatibility handling..."
                            
                            // Try to set JAVA_HOME to a compatible version if available
                            def java17Available = sh(script: 'which java17 || which java-17', returnStatus: true) == 0
                            
                            if (java17Available) {
                                echo "☕ Found Java 17, using it for SonarQube analysis..."
                                sh '''
                                    export JAVA_HOME=$(dirname $(dirname $(which java17 || which java-17)))
                                    export PATH=$JAVA_HOME/bin:$PATH
                                    java -version
                                    sonar-scanner -Dsonar.token=squ_82e7677f348761f3f5d985be099af4348abe7615 -Dsonar.verbose=true
                                '''
                            } else {
                                echo "⚠️ Java 17 not found, trying with current Java version..."
                                sh 'sonar-scanner -Dsonar.token=YOUR_ACTUAL_TOKEN_HERE -Dsonar.verbose=true'
                            }
                        }
                        
                        echo "✅ SonarQube analysis completed successfully!"
                        
                    } catch (Exception e) {
                        echo "❌ SonarQube analysis failed: ${e.getMessage()}"
                        echo "💡 This is likely due to Java version compatibility issues."
                        echo "🔧 Your SonarQube server requires Java 17, but Jenkins is running Java 11."
                        echo "📋 Possible solutions:"
                        echo "   1. Install Java 17 on your Jenkins agent"
                        echo "   2. Downgrade your SonarQube server to a version compatible with Java 11"
                        echo "   3. Use a Docker-based SonarQube scanner with Java 17"
                        
                        // Don't fail the pipeline completely, mark as unstable
                        currentBuild.result = 'UNSTABLE'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                // Only wait for Quality Gate if SonarQube analysis was successful
                if (currentBuild.result == null || currentBuild.result == 'SUCCESS') {
                    try {
                        echo "⏳ Waiting for SonarQube Quality Gate..."
                        timeout(time: 10, unit: 'MINUTES') {
                            def qg = waitForQualityGate()
                            echo "🎯 Quality Gate result: ${qg.status}"
                            if (qg.status != 'OK') {
                                currentBuild.result = 'UNSTABLE'
                            }
                        }
                    } catch (Exception e) {
                        echo "⚠️ Could not wait for Quality Gate: ${e.getMessage()}"
                        echo "Please check SonarQube dashboard manually at: ${SONAR_HOST_URL}"
                    }
                }
            }
        }
        success {
            echo "🎉 Pipeline completed successfully!"
            echo "🔍 View SonarQube results at: ${SONAR_HOST_URL}/dashboard?id=nodeapp"
        }
        failure {
            echo "💥 Pipeline failed. Check the logs above for details."
            echo "💡 Possible solutions:"
            echo "  1. Configure SonarQube Scanner in Jenkins (Manage Jenkins -> Global Tool Configuration)"
            echo "  2. Install sonar-scanner on the Jenkins agent"
            echo "  3. Check SonarQube server connectivity at ${SONAR_HOST_URL}"
        }
        unstable {
            echo "⚠️ Pipeline completed with warnings (Quality Gate issues)."
            echo "🔍 Check SonarQube dashboard at: ${SONAR_HOST_URL}/dashboard?id=nodeapp"
        }
    }
}
