pipeline {
    agent any

    environment {
        SONAR_HOST_URL = "http://192.168.50.4:9000"
    }

    stages {
        // Stage 1: Checkout source code
        stage('Checkout Source Code') {
            steps {
                script {
                    echo "🔄 Checking out source code from GitHub..."
                    git branch: 'main', url: 'https://github.com/Aya-Bs/Lavoro.git'
                    echo "✅ Source code checkout completed"
                }
            }
        }

        // Stage 2: Verify workspace and files
        stage('Verify Project Structure') {
            steps {
                script {
                    echo "📁 Current workspace contents:"
                    sh 'ls -la'
                    
                    echo "🔍 Checking for required files..."
                    
                    if (fileExists('sonar-project.properties')) {
                        echo "✅ sonar-project.properties found"
                        echo "📄 sonar-project.properties content:"
                        sh 'head -10 sonar-project.properties'
                    } else {
                        error("❌ sonar-project.properties file is required for SonarQube analysis")
                    }
                }
            }
        }

        // Stage 3: SonarQube Analysis
        stage('SonarQube Analysis') {
            steps {
                script {
                    echo "🔍 Starting SonarQube analysis..."
                    // Utiliser l'installation SonarQube configurée globalement dans Jenkins
                    withSonarQubeEnv('SonarQube') {
                        sh 'sonar-scanner'
                    }
                    echo "✅ SonarQube analysis completed successfully!"
                }
            }
        }
    }

    post {
        always {
            script {
                // Only wait for Quality Gate if SonarQube analysis was successful
                if (currentBuild.result == null || currentBuild.result == 'SUCCESS') {
                    try {
                        echo "⏳ Waiting for SonarQube Quality Gate..."
                        timeout(time: 10, unit: 'MINUTES') {
                            def qg = waitForQualityGate()
                            echo "🎯 Quality Gate result: ${qg.status}"
                            if (qg.status != 'OK') {
                                currentBuild.result = 'UNSTABLE'
                            }
                        }
                    } catch (Exception e) {
                        echo "⚠️ Could not wait for Quality Gate: ${e.getMessage()}"
                        echo "Please check SonarQube dashboard manually at: ${SONAR_HOST_URL}"
                    }
                }
            }
        }
        success {
            echo "🎉 Pipeline completed successfully!"
            echo "🔍 View SonarQube results at: ${SONAR_HOST_URL}/dashboard?id=nodeapp"
        }
        failure {
            echo "💥 Pipeline failed. Check the logs above for details."
            echo "💡 Possible solutions:"
            echo "  1. Configure SonarQube Scanner in Jenkins (Manage Jenkins -> Global Tool Configuration)"
            echo "  2. Install sonar-scanner on the Jenkins agent"
            echo "  3. Check SonarQube server connectivity at ${SONAR_HOST_URL}"
        }
        unstable {
            echo "⚠️ Pipeline completed with warnings (Quality Gate issues)."
            echo "🔍 Check SonarQube dashboard at: ${SONAR_HOST_URL}/dashboard?id=nodeapp"
        }
    }
}
